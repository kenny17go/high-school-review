{
  "name": "high-school-review",
  "version": "5.0.0",
  "private": true,
  "description": "高中段考複習平台，靜態網站與唯讀教材資料適配",
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test:data": "node tests/routing.test.cjs",
    "test:browser": "node tests/browser.test.cjs",
    "test": "npm run validate && npm run test:v5 && npm run test:gsat && npm run test:batch-import && npm run test:golden && npm run test:golden-114 && npm run test:matha-114-explanation-v2 && npm run test:golden-113 && npm run test:golden-112 && npm run test:golden-111 && npm run test:golden-chinese-115 && npm run test:explanation-v2 && npm run test:matha-explanation-v2 && npm run test:migration && npm run test:browser",
    "test:v5": "node tests/v5-data.test.cjs",
    "test:migration": "node tests/migration.test.mjs",
    "test:gsat": "node tests/gsat-115.test.cjs",
    "test:batch-import": "node tests/batch-exam-import.test.mjs",
    "test:golden": "node tests/gsat-115-golden.test.mjs",
    "test:golden-114": "node tests/gsat-114-golden.test.mjs",
    "test:golden-113": "node tests/gsat-113-golden.test.mjs",
    "test:golden-112": "node tests/gsat-112-golden.test.mjs",
    "test:golden-111": "node tests/gsat-111-golden.test.mjs",
    "test:golden-chinese-115": "node tests/gsat-115-chinese-golden.test.mjs",
    "test:explanation-v2": "node --test tests/gsat-115-chinese-explanation-v2.test.mjs",
    "test:matha-explanation-v2": "node --test tests/gsat-115-matha-explanation-v2.test.mjs",
    "test:matha-114-explanation-v2": "node --test tests/gsat-114-matha-explanation-v2.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "playwright": "1.62.1"
  },
  "displayVersion": "5.0"
}
